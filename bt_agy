#!/usr/bin/env bash
# BookTrans с умолчаниями для агента «agy».
# Какими моделями он работает — записано в наборе PRESETS["agy"]: цепочка
# Gemini → Claude → gpt-oss на смысловых проходах, дешёвая Flash с Sonnet за
# спиной на разметке и правке распознавания. Любой явный ключ сильнее набора:
#   ./bt_agy книга.epub --to de --editor gemini-3.1-pro-high,claude:claude-opus-5
export BT_AGENT="agy"
exec "$(dirname "$(readlink -f "$0")")/booktrans" "$@"
