#!/usr/bin/env bash
# BookTrans с умолчаниями для агента «agy».
# Всё остальное — как у booktrans; любой явный ключ сильнее умолчания:
#   ./bt_agy книга.epub --to de --model другая-модель
export BT_AGENT="agy"
export BT_MODEL="gemini-3.1-pro-high"
exec "$(dirname "$(readlink -f "$0")")/booktrans" "$@"
