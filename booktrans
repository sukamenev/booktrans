#!/usr/bin/env python3
"""Запуск из папки с исходниками, без установки.

Установленный пакет даёт команду `booktrans` сам (см. pyproject.toml);
этот файл нужен тому, кто взял проект из git и правит его на месте.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))
from booktrans.cli import run

if __name__ == "__main__":
    sys.exit(run())
