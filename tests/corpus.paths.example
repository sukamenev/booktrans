# Откуда сборщик берёт книги, из которых складывает набор для проверок.
# Скопируйте в corpus.paths и поправьте под себя. То же самое можно задать
# переменными окружения — они сильнее этого файла.
#
# Куда набор складывается, тут не задаётся: всегда tests/corpus.

# Папка с книгами, названными в build_corpus.py поимённо (Semiosis, Neverness…)
BT_BOOKS = ..

# Домашняя библиотека: оттуда берутся fb2, txt и pdf
BT_LIB = ~/Biblioteka

# Куда скачаны книги «Проекта Гутенберг» (pg2701.epub, pg2707.epub)
BT_GUTENBERG = /tmp/gut
